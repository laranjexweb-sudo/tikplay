PORT=3100
# Optional fallback; the key can also be saved in Admin > Global settings.
# Enable individual accounts in Admin after configuring the integration.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4_turbo
# Optional absolute private configuration path, shared by Node and its Python daemon.
# ELEVENLABS_CONFIG_PATH=
JWT_SECRET=troque-por-um-segredo-forte
REGISTER_MODE=invite
PUBLIC_BASE_URL=https://painel.tikplay.com.br

# Mercado Pago (assinaturas) - preencher com seu access token
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# TTS Kokoro (servico local)
KOKORO_URL=http://localhost:8000

# Contextos / IA local (LM Studio) e OpenRouter (charadas)
OPENROUTER_API_KEY=
# Used by charadas and the Super Admin context generator (Claude Haiku 5.5).
# LLM_BASE_URL/LLM_MODEL below only apply to the legacy standalone local script.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen2.5-coder-7b-instruct
CORRIGE_TOP=200

# Diagnóstico temporário de níveis TikTokLive (log throttled de user/barrage).
# Ativar somente para diagnóstico: TIKTOK_LEVEL_DIAGNOSTICS=1
# TIKTOK_LEVEL_DIAGNOSTICS=1
